# Base de datos (obligatoria: el backend no arranca si no puede conectarse)
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/sentinel_ai_guard

# Origen del frontend permitido por CORS (lista separada por comas, nunca "*")
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Autenticacion local. En despliegues reemplaza la clave por al menos 32 caracteres aleatorios.
JWT_SECRET_KEY=change-this-local-jwt-secret-before-deploying
JWT_ISSUER=sentinel-ai-guard
JWT_AUDIENCE=sentinel-ai-guard-web
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Ollama local
OLLAMA_BASE_URL=http://localhost:11434

# Uso 1: evaluacion de seguridad (JSON estricto, temperature 0)
OLLAMA_SECURITY_MODEL=gemma3:4b
OLLAMA_SECURITY_TIMEOUT_SECONDS=120
OLLAMA_SECURITY_CONTEXT_TOKENS=8192
OLLAMA_SECURITY_MAX_OUTPUT_TOKENS=300

# Uso 2: descubrimiento obligatorio de categorias sensibles sobre contenido local sin enmascarar
OLLAMA_DISCOVERY_MODEL=gemma3:4b
OLLAMA_DISCOVERY_TIMEOUT_SECONDS=180
OLLAMA_DISCOVERY_CONTEXT_TOKENS=8192
OLLAMA_DISCOVERY_MAX_OUTPUT_TOKENS=200
OLLAMA_DISCOVERY_MAX_INPUT_CHARS=24000

# Uso 4: generacion de la respuesta (solo contenido ALLOWED)
OLLAMA_GENERATION_MODEL=gemma3:4b
OLLAMA_GENERATION_TIMEOUT_SECONDS=180
OLLAMA_GENERATION_CONTEXT_TOKENS=8192
OLLAMA_GENERATION_MAX_OUTPUT_TOKENS=800
OLLAMA_GENERATION_MAX_DOCUMENT_CHARS=24000

# Limites del prompt
PROMPT_MIN_LENGTH=3
PROMPT_MAX_LENGTH=8000
